    },
    "Opens a delivery's details in Stork.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre los detalles de un parto en Stork."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les détails d'un accouchement dans Stork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkで分娩の詳細を開きます。"
          }
        }
      }
    },
    "Quickly log a delivery you performed. You can add details like measurements later in Stork.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra rápidamente un parto que atendiste. Puedes agregar detalles como las medidas más tarde en Stork."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez rapidement un accouchement que vous avez effectué. Vous pourrez ajouter des détails comme les mesures plus tard dans Stork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "担当した分娩をすばやく記録します。測定値などの詳細は、後からStorkで追加できます。"
          }
        }
      }
    },
