    "No babies delivered yet this week.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay bebés esta semana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun bébé mis au monde cette semaine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週はまだ赤ちゃんの記録がありません。"
          }
        }
      }
    },
    "Nothing logged — a delivery needs at least one baby.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se registró nada — un parto necesita al menos un bebé."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été enregistré — un accouchement nécessite au moins un bébé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されませんでした — 分娩には赤ちゃんが1人以上必要です。"
          }
        }
      }
    },
