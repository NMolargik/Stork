    "Opens Stork to the new delivery form.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Stork en el formulario de nuevo parto."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Stork sur le formulaire de nouvel accouchement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkの新規分娩フォームを開きます。"
