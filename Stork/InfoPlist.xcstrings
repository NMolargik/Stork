    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork reads your health data just to display your step count for the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork lee tus datos de salud solo para mostrar tu conteo de pasos del día."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork lit vos données de santé uniquement pour afficher votre nombre de pas de la journée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkは今日の歩数を表示する目的でのみヘルスケアデータを読み取ります。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork reads your daily step count to display a pedometer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork lee tu conteo diario de pasos para mostrar un podómetro."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork lit votre nombre de pas quotidien pour afficher un podomètre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkは歩数計を表示するために毎日の歩数を読み取ります。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork uses your location once, only when you choose to attach a weather snapshot to a delivery. Your location is never stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork usa tu ubicación una sola vez, solo cuando eliges adjuntar una captura del clima a un parto. Tu ubicación nunca se guarda."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork utilise votre position une seule fois, uniquement lorsque vous choisissez de joindre un aperçu météo à un accouchement. Votre position n’est jamais enregistrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkは、分娩に天気のスナップショットを添付することを選んだときにのみ、一度だけ位置情報を使用します。位置情報は保存されません。"
          }
        }
      }
    },
    "NSWeatherUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork fetches the current weather only when you choose to attach a weather snapshot to a delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork obtiene el clima actual solo cuando eliges adjuntar una captura del clima a un parto."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork récupère la météo actuelle uniquement lorsque vous choisissez de joindre un aperçu météo à un accouchement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkは、分娩に天気のスナップショットを添付することを選んだときにのみ、現在の天気を取得します。"
          }
        }
      }
    },
    "New Delivery": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo parto"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvel accouchement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規分娩"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork uses Face ID only to unlock the app when you turn on Require Face ID. Nothing about your face is stored or shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork usa Face ID solo para desbloquear la app cuando activas Requerir Face ID. Nada sobre tu rostro se guarda ni se comparte."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork utilise Face ID uniquement pour déverrouiller l'app lorsque vous activez Exiger Face ID. Rien sur votre visage n'est enregistré ni partagé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StorkはFace IDを「Face IDを必須にする」をオンにしたときのアプリのロック解除にのみ使用します。顔に関する情報が保存・共有されることはありません。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
