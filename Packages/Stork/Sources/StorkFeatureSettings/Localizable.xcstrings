          }
        }
      }
    },
    "Dates and times, delivery method, whether an epidural was used, each baby's sex, weight and length, your role, and any short note or tag you choose to add.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechas y horas, método de parto, si hubo epidural, el sexo, peso y talla de cada bebé, tu rol y cualquier nota breve o etiqueta que decidas añadir."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates et heures, mode d'accouchement, recours ou non à la péridurale, sexe, poids et taille de chaque bébé, votre rôle, ainsi que toute courte note ou étiquette que vous choisissez d'ajouter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付と時刻、分娩方法、硬膜外麻酔の有無、各赤ちゃんの性別・体重・身長、あなたの役割、そして追加することにした短いメモやタグ。"
          }
        }
      }
    },
    "What it never asks for": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que nunca pide"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'il ne demande jamais"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "求めないもの"
          }
        }
      }
    },
    "No patient or baby names, medical record numbers, dates of birth, hospital or unit, and no account or sign-in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin nombres de pacientes ni bebés, números de expediente, fechas de nacimiento, hospital o unidad, y sin cuenta ni inicio de sesión."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nom de patient ou de bébé, numéro de dossier, date de naissance, hôpital ou unité, et aucun compte ni connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "患者や赤ちゃんの名前、診療記録番号、生年月日、病院や部署は不要で、アカウントやサインインもありません。"
          }
        }
      }
    },
    "Stays on your device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en tu dispositivo"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste sur votre appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス内に保存"
          }
        }
      }
    },
    "Your log lives on your iPhone, iPad and Apple Watch. There are no Stork servers, no analytics about your births and no advertising.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro vive en tu iPhone, iPad y Apple Watch. No hay servidores de Stork, ni analíticas sobre tus partos, ni publicidad."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal reste sur votre iPhone, iPad et Apple Watch. Il n'y a aucun serveur Stork, aucune analyse de vos accouchements et aucune publicité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はiPhone、iPad、Apple Watchに保存されます。Storkのサーバーはなく、分娩に関する分析や広告もありません。"
          }
        }
      }
    },
    "Private iCloud only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo iCloud privado"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud privé seulement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートなiCloudのみ"
          }
        }
      }
    },
    "If iCloud is on, your log syncs through your own private iCloud database. Molargik Software cannot see it, and neither can anyone else.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iCloud está activado, tu registro se sincroniza mediante tu propia base de datos privada de iCloud. Molargik Software no puede verlo, ni nadie más."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iCloud est activé, votre journal se synchronise via votre propre base de données iCloud privée. Molargik Software ne peut pas le voir, et personne d'autre non plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudがオンの場合、記録はあなた専用のプライベートなiCloudデータベースで同期されます。Molargik Softwareを含め、誰も閲覧できません。"
          }
        }
      }
    },
    "Optional lock": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo opcional"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillage facultatif"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプションのロック"
          }
        }
      }
    },
    "Turn on Require Face ID in Privacy to ask for Face ID or your passcode when Stork opens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Requerir Face ID en Privacidad para pedir Face ID o tu código al abrir Stork."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Exiger Face ID dans Confidentialité pour demander Face ID ou votre code à l'ouverture de Stork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシー」で「Face IDを必須にする」をオンにすると、Storkを開くときにFace IDまたはパスコードが求められます。"
          }
        }
      }
    },
    "Keep notes free of identifiers": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las notas sin identificadores"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les notes sans identifiants"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモに識別情報を入れない"
          }
        }
      }
    },
    "Write \"twins on Christmas Eve\", not a name or a date of birth. Stork warns you if a note looks like it has an identifier, and it never imports them from a CSV.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe \"gemelos en Nochebuena\", no un nombre ni una fecha de nacimiento. Stork te avisa si una nota parece tener un identificador y nunca los importa desde un CSV."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez « jumeaux la veille de Noël », pas un nom ni une date de naissance. Stork vous avertit si une note semble contenir un identifiant, et n'en importe jamais depuis un CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前や生年月日ではなく「クリスマスイブに双子」のように書いてください。メモに識別情報らしきものがあるとStorkが知らせ、CSVからは一切インポートしません。"
          }
        }
      }
    },
    "Why that matters": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué importa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi c'est important"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ重要か"
          }
        }
      }
    },
    "A log with no identifiers is just your own career memories, which is why it is safe to keep for years. Follow your employer's policies too: they come first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un registro sin identificadores son solo tus recuerdos de carrera, por eso es seguro conservarlo durante años. Sigue también las políticas de tu empleador: tienen prioridad."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Un journal sans identifiants n'est que vos souvenirs de carrière, ce qui le rend sûr à conserver pendant des années. Suivez aussi les politiques de votre employeur : elles ont préséance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "識別情報のない記録は、あなた自身のキャリアの思い出にすぎないため、長年安心して保存できます。勤務先の方針にも従ってください。そちらが優先されます。"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Rate Stork": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorar Stork"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluer Stork"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkを評価"
          }
        }
      }
    },
    "Share Stork": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir Stork"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager Stork"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkを共有"
          }
        }
      }
    },
    "Stork is a delivery log for labor and delivery nurses, midwives and OBs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork es un registro de partos para enfermeras de labor y parto, parteras y obstetras."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stork est un registre d'accouchements pour les infirmières de travail et d'accouchement, les sages-femmes et les obstétriciens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Storkは、分娩看護師、助産師、産科医のための分娩記録アプリです。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
