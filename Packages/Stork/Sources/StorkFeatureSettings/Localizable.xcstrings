    "This action cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
