    "Already bought Stork before it went free? Open Stork Pro and tap Restore Purchases.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Compraste Stork antes de que fuera gratis? Abre Stork Pro y toca Restaurar compras."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez acheté Stork avant qu’il devienne gratuit? Ouvrez Stork Pro et touchez Restaurer les achats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料化前にStorkを購入された方は、Stork Proを開いて「購入を復元」をタップしてください。"
          }
        }
      }
    },
