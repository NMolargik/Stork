    "Sign in to iCloud in Settings to enable sync.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud en Configuración para habilitar la sincronización."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à iCloud dans Réglages pour activer la synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期を有効にするには、設定でiCloudにサインインしてください。"
          }
        }
      }
    },
