    "This will permanently delete all %lld delivery records and their associated baby data. This action cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente los %lld registros de partos y los datos de bebés asociados. Esta acción no se puede deshacer."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement les %lld dossiers d'accouchement et les données de bébés associées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の分娩記録と関連する赤ちゃんのデータをすべて完全に削除します。この操作は取り消せません。"
          }
        }
      }
    },
    "This will permanently remove all %lld deliveries.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente los %lld partos."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement les %lld accouchements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の分娩をすべて完全に削除します。"
          }
        }
      }
    },
    "Unlocked. Thank you for supporting Stork!": {
      "localizations": {
        "es": {
          "stringUnit": {
