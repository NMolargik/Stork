    "Plus ^[%lld earlier baby](inflect: true), estimated. These are in your career totals, not this month's jar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más ^[%lld bebé anterior](inflect: true), estimado. Están en tus totales de carrera, no en el frasco de este mes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ^[%lld bébé antérieur](inflect: true), estimé. Ils figurent dans vos totaux de carrière, pas dans le bocal de ce mois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに以前の赤ちゃん%lld人(推定)。キャリア合計には含まれますが、今月のジャーには含まれません。"
          }
        }
      }
    }
