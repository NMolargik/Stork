    "Examples: \"Teaching Moment\", \"First Solo\", \"Night Shift\". Do not include patient information.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplos: \"Momento de enseñanza\", \"Primer parto sola\", \"Turno nocturno\". No incluyas información de pacientes."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemples : \"Moment d'enseignement\", \"Premier solo\", \"Quart de nuit\". N'incluez aucun renseignement sur les patientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「指導の機会」「初めての単独担当」「夜勤」。患者情報は含めないでください。"
          }
        }
      }
    },
